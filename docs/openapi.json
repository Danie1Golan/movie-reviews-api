  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the token returned from /api/auth/login"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "example": "Alice Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "format": "password",
            "example": "VerySecurePassword123!"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT expires in 2 hours"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "MovieInput": {
        "type": "object",
        "required": [
          "title",
          "year",
          "genre",
          "director",
          "actors",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "example": "Interstellar"
          },
          "year": {
            "type": "integer",
            "minimum": 1888,
            "example": 2014
          },
          "genre": {
            "type": "string",
            "example": "Science Fiction"
          },
          "director": {
            "type": "string",
            "example": "Christopher Nolan"
          },
          "actors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "example": [
              "Matthew McConaughey",
              "Anne Hathaway"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "example": "An epic science fiction movie about space exploration."
          }
        }
      },
      "Movie": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MovieInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reviewCount": {
                "type": "integer",
                "minimum": 0,
                "example": 2
              },
              "averageRating": {
                "type": "number",
                "nullable": true,
                "minimum": 1,
                "maximum": 10,
                "example": 8.5,
                "description": "Null until first review"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "MoviePatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "genre": {
            "type": "string"
          },
          "director": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ReviewInput": {
        "type": "object",
        "required": [
          "rating",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "example": 9
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "example": "Great acting and visual effects."
          }
        }
      },
      "ReviewPatch": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000
          }
        }
      },
      "Review": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "movieId": {
                "type": "string"
              },
              "userId": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "MovieList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Movie"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "pages": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ReviewList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          }
        }
      },
      "UserList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "RoleInput": {
        "type": "object",
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      }
    }
  }
}